{
  "base_model": "openai-community/gpt2",
  "new_tokenizer_path": "./tokenizer",
  "train_data_path": "./data/train.txt",
  "output_dir": "./output",
  "seed": 42,
  "device": null,
  
  "reinit_strategy": "mean",
  "block_size": 512,
  "batch_size": 4,
  
  "train_embeddings": true,
  "train_lm_head": true,
  "train_transformer": false,
  
  "num_epochs": 3,
  "learning_rate": 5e-5,
  "warmup_steps": 100,
  "gradient_accumulation_steps": 1,
  "max_grad_norm": 1.0,
  "logging_steps": 10,
  "save_steps": 500,
  
  "test_prompt": "こんにちは"
}
